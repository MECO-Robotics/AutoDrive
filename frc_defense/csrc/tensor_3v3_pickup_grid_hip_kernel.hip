__global__ void possession_counts_kernel(const int64_t* owner,int64_t* counts,
    int worlds,int pieces){
  const int row=blockIdx.x,world=row/6,robot=row-world*6,lane=threadIdx.x;
  if(world>=worlds)return;
  __shared__ int partial[256];
  int local=0;
  for(int piece=lane;piece<pieces;piece+=blockDim.x)
    local+=owner[world*pieces+piece]==robot;
  partial[lane]=local;__syncthreads();
  for(int offset=blockDim.x/2;offset>0;offset>>=1){
    if(lane<offset)partial[lane]+=partial[lane+offset];
    __syncthreads();
  }
  if(lane==0)counts[row]=partial[0];
}

void possession_counts_launch(const int64_t* owner,int64_t* counts,int worlds,
    int pieces,hipStream_t stream){
 hipLaunchKernelGGL(( possession_counts_kernel), dim3(dim3(worlds*6)),dim3(dim3(256)),0,stream, 
      owner,counts,worlds,pieces);
}
